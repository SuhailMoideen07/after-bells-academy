# REQUIRED: JWT Secret for session token signing (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_generated_jwt_secret_64_characters

# SUPABASE POSTGRESQL DATABASE URLS (MUMBAI, INDIA - AP-SOUTH-1)
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# CLOUDINARY CDN AVATAR STORAGE
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# GMAIL SMTP EMAIL CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM_NAME="After Bells Academy"

# OPTIONAL: Production Application Base URL (e.g. https://afterbellsacademy.com)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
